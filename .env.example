# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes em
# Vercel > Project > Settings > Environment Variables (ambiente Production).
# Sem valor, o recurso correspondente simplesmente não é carregado.

# Domínio canônico do site, sem barra no final.
NEXT_PUBLIC_SITE_URL=https://www.pousadamelevalogo.com.br

# Google Analytics 4: Admin > Fluxos de dados > ID da métrica (formato G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# Meta Pixel: Gerenciador de Eventos > Fontes de dados > ID do pixel (só números).
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console: Adicionar propriedade > Prefixo do URL > Tag HTML.
# Cole apenas o valor de content="...".
GOOGLE_SITE_VERIFICATION=

# Meta: Configurações do negócio > Segurança da marca > Domínios > Metatag.
# Cole apenas o valor de content="...".
META_DOMAIN_VERIFICATION=
